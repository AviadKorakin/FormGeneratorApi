extends layout

block content
  h1 Error
    i.fas.fa-exclamation-circle(style="margin-left: 10px; color: #dc3545")
    br
    | Oops! Something went wrong.

  .container-fluid
    .row
      .col-md-12
        .alert.alert-danger(
          role="alert",
          style="max-width: 600px; margin: 20px auto"
        )
          h2 Error Code: #{ error.status || 'Unknown Error' }
          p #{ error.message || 'An unexpected error occurred. Please try again later.' }
        if error.stack
          .card(
            style="max-width: 600px; margin: 20px auto; border-color: #dc3545"
          )
            .card-header.bg-danger.text-white
              i.fas.fa-bug(style="margin-right: 10px")
              span Error Stack Trace
            .card-body
              pre #{ error.stack }
