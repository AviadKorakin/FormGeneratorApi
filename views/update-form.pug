                        )
                      #design-colors.collapse.mt-2
                        .row.mt-2
                          .col
                            label(
                              for="background-color",
                              style="font-size: 0.8rem; display: block; margin-bottom: 5px; max-width: 150px"
                            )
                              i.fas.fa-fill-drip(
                                style="color: #3498db; margin-right: 5px"
                              )
                              span Background Color
                            input#background-color.form-control.mt-2(
                              type="color",
                              style="max-width: 150px"
                            )
                        .row.mt-2
                          .col
                            label(
                              for="text-color",
                              style="font-size: 0.8rem; display: block; margin-bottom: 5px; max-width: 150px"
                            )
                              i.fas.fa-fill-drip(
                                style="color: #e67e22; margin-right: 5px"
                              )
                              span Text Color
                            input#text-color.form-control.mt-2(
                              type="color",
                              style="max-width: 150px"
                            )
                        .row.mt-2
                          .col
                            label(
                              for="button-background-color",
                              style="font-size: 0.8rem; display: block; margin-bottom: 5px; max-width: 150px"
                            )
                              i.fas.fa-fill-drip(
                                style="color: #9b59b6; margin-right: 5px"
                              )
                              span Button Background Color
                            input#button-background-color.form-control.mt-2(
                              type="color",
                              style="max-width: 150px"
                            )
                        .row.mt-2
                          .col
                            label(
