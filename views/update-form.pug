extends layout
block content
  h1 Update Form
    i.fas.fa-sync-alt(style="margin-left: 10px; color: #1cc9c0")

  .container-fluid
    .row
      // Form Selector
    .col-md-12
      .form-group
        label(for="form-id") Select Form ID to Update:
        // First row: ComboBox and copy icon
        .row
          .col-auto
            select#form-id.form-control(
              style="max-width: 350px; display: inline-block; margin-bottom: 10px"
            )
              option(value="", disabled, selected) Choose a Form ID
          .col-auto
            i#copy-combobox-icon.fas.fa-copy(
              style="cursor: pointer; color: #1cc9c0; margin-left: 10px; font-size: 1.2rem"
            )
        // Second row: Load Form button
        .row.mt-2
          .col
            button#load-form.btn.btn-primary.btn-sm(
              type="button",
              style="margin-left: 20px"
            )
              i.fas.fa-download(style="margin-right: 5px")
              span Load Form
    #toolbar-row.row.hidden
      // Toolbar (Left Side)
      .col-md-4.toolbar
        table
          tbody
            // Title Section
            tr
              td
                .card.hover-card
                  .card-header
                    i.fas.fa-heading(style="color: #3498db")
                    span Title
                  .card-body
                    textarea#title-text.form-control.mt-2.auto-resize(
                      placeholder="Enter title text"
                    )

                    // Collapsible Color Selection for Title
                    .collapse-section
                      button.btn.btn-icon.toggle-collapse.mt-2(
                        type="button",
                        data-target="#title-colors"
                      )
                        i.fas.fa-palette(
                          style="margin-right: 5px; color: #8e44ad"
                        )
                        span Colors
                        i.fas.fa-chevron-down.toggle-icon(
                          style="color: #fff; margin-left: 10px"
                        )
                      #title-colors.collapse.mt-2
                        .row.mt-2
                          .col
                            label(
                              for="title-background-color",
                              style="font-size: 0.8rem; display: block"
                            )
                              i.fas.fa-fill-drip(
                                style="color: #9b59b6; margin-right: 5px"
                              )
                              span Background Color
                            input#title-background-color.form-control.mt-2(
                              type="color",
                              style="max-width: 150px"
                            )
                        .row.mt-2
                          .col
                            label(
                              for="title-text-color",
                              style="font-size: 0.8rem; display: block"
                            )
                              i.fas.fa-font(
                                style="color: #3498db; margin-right: 5px"
                              )
                              span Text Color
                            input#title-text-color.form-control.mt-2(
                              type="color",
                              style="max-width: 150px"
                            )

                        .row.mt-2
                          .col
                            label(
                              for="title-border-color",
                              style="font-size: 0.8rem; display: block"
                            )
                              i.fas.fa-border-style(
                                style="color: #16a085; margin-right: 5px"
                              )
                              span Border Color
                            input#title-border-color.form-control.mt-2(
                              type="color",
                              style="max-width: 150px"
                            )

                    button.btn.btn-icon.add-to-form.mt-2(
                      type="button",
                      data-type="title"
                    )
                      i.fas.fa-check(style="color: #2ecc71")

            // ComboBox Section
            tr
              td
                .card.hover-card
                  .card-header
                    i.fas.fa-list.dropdown-icon(style="color: #3498db")
                    span ComboBox
                  .card-body
                    textarea#combobox-question.form-control.mt-2.auto-resize(
                      placeholder="Enter question"
                    )

                    // Options Section
                    .options-section
                      .option-list
                      button.btn.btn-icon.add-combobox-option.mt-2(
                        type="button"
                      )
                        i.fas.fa-plus(style="color: #27ae60")
                    hr(style="margin: 10px 0")

                    // Collapsible Color Selection for ComboBox
                    .collapse-section
                      button.btn.btn-icon.toggle-collapse.mt-2(
                        type="button",
                        data-target="#combobox-colors"
                      )
                        i.fas.fa-palette(
                          style="margin-right: 5px; color: #8e44ad"
                        )
                        span Colors
                        i.fas.fa-chevron-down.toggle-icon(
                          style="color: #fff; margin-left: 10px"
                        )
                      #combobox-colors.collapse.mt-2
                        .row.mt-2
                          .col
                            label(
                              for="combobox-selected-item-background-color",
                              style="font-size: 0.8rem; display: block"
                            )
                              i.fas.fa-fill-drip(
                                style="color: #3498db; margin-right: 5px"
                              )
                              span Background Color
                            input#combobox-background-color.form-control.mt-2(
                              type="color",
                              style="max-width: 150px"
                            )
                        .row.mt-2
                          .col
                            label(
                              for="combobox-dropdown-background-color",
                              style="font-size: 0.8rem; display: block"
                            )
                              i.fas.fa-fill-drip(
                                style="color: #9b59b6; margin-right: 5px"
                              )
                              span Dropdown Background Color
                            input#combobox-dropdown-background-color.form-control.mt-2(
                              type="color",
                              style="max-width: 150px"
                            )

                        .row.mt-2
                          .col
                            label(
                              for="combobox-item-text-color",
                              style="font-size: 0.8rem; display: block"
                            )
                              i.fas.fa-palette(
                                style="color: #e74c3c; margin-right: 5px"
                              )
                              span Item Text Color
                            input#combobox-item-text-color.form-control.mt-2(
                              type="color",
                              style="max-width: 150px"
                            )
                        .row.mt-2
                          .col
                            label(
                              for="combobox-selected-item-background-color",
                              style="font-size: 0.8rem; display: block"
                            )
                              i.fas.fa-fill-drip(
                                style="color: #16a085; margin-right: 5px"
                              )
                              span Selected Item Background Color
                            input#combobox-selected-item-background-color.form-control.mt-2(
                              type="color",
                              style="max-width: 150px"
                            )

                        .row.mt-2
                          .col
                            label(
                              for="combobox-selected-item-text-color",
                              style="font-size: 0.8rem; display: block"
                            )
                              i.fas.fa-palette(
                                style="color: #e67e22; margin-right: 5px"
                              )
                              span Selected Item Text Color
                            input#combobox-selected-item-text-color.form-control.mt-2(
                              type="color",
                              style="max-width: 150px"
                            )

                    button.btn.btn-icon.add-to-form.mt-2(
                      type="button",
                      data-type="combobox"
                    )
                      i.fas.fa-check(style="color: #2ecc71")

            // TextBox Section
            tr
              td
                .card.hover-card
                  .card-header
                    i.fas.fa-pencil-alt.textbox-icon(style="color: #e67e22")
                    span TextBox
                  .card-body
                    textarea#textbox-question.form-control.mt-2.auto-resize(
                      placeholder="Enter question"
                    )
                    // Hint Text Section
                    label(for="textbox-hint") Hint
                    input#textbox-hint.form-control.mt-2(
                      type="text",
                      placeholder="Optional Hint"
                    )

                    // Collapsible Color Selection for TextBox
