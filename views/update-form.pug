      // Preview (Right Side)
      .col-md-8.preview
        h2
          i.fas.fa-eye(style="margin-right: 10px; color: #3498db")
          span Form Preview
        .card.hover-card
          .card-header
            i.fas.fa-pen(style="color: #3498db")
            span Form Name
          .card-body
            input#form-name.form-control.mt-2(
              type="text",
              placeholder="Enter form name here",
