    .slider(style="display: flex; transition: transform 0.5s ease-in-out")
      img.slider-image(
        src="/images/1.png",
        alt="Form Builder UI Screenshot 1",
        style="width: 100%; max-width: 300px"
      )
      img.slider-image(
        src="/images/2.png",
        alt="Form Builder UI Screenshot 2",
        style="width: 100%; max-width: 300px"
      )
      img.slider-image(
        src="/images/3.png",
        alt="Form Builder UI Screenshot 3",
        style="width: 100%; max-width: 300px"
      )
      img.slider-image(
        src="/images/4.png",
        alt="Form Update Screenshot",
        style="width: 100%; max-width: 300px"
      )
      img.slider-image(
        src="/images/5.png",
        alt="Feedback Viewer Screenshot",
        style="width: 100%; max-width: 300px"
      )
      img.slider-image(
        src="/images/6.png",
        alt="Feedback Analytics Screenshot",
        style="width: 100%; max-width: 300px"
      )
      img.slider-image(
        src="/images/7.png",
        alt="Feedback Analytics Screenshot",
        style="width: 100%; max-width: 300px"
      )
    .slider-navigation
      button.btn.btn-icon.prev-button(
        type="button",
        data-type="prev",
        aria-label="Previous Slide",
        style="position: absolute; left: 0; top: 50%; transform: translateY(-50%); padding: 0; background: none; border: none; opacity: 0.5"
